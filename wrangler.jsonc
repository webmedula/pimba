{
  // Pimba v1.1.0 — Cloudflare Workers (deploy automático a partir do GitHub)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pimba",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/resultados/*", "/estatisticas/*"]
  },
  "observability": { "enabled": true },
  // Builds de branches/PRs no Cloudflare rodam `wrangler preview`, que exige este bloco (pode ficar vazio)
  "previews": {}
  // Para testar com dados falsos: CAIXA_API_BASE em .dev.vars (veja README)
}
